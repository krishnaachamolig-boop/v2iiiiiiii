# ============================================================
# V2i Personal AI — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example is tracked in git.
# Anything prefixed VITE_ is exposed to the browser bundle:
# do NOT put secret/service-role keys behind a VITE_ prefix.
# ============================================================

# ---------- Supabase (required for auth, DB, storage, memory) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is SERVER-SIDE ONLY. Used by supabase/functions (edge functions),
# never imported into src/. If you add server-side jobs, set this in the Supabase
# project's function secrets, not in this file.
# SUPABASE_SERVICE_ROLE_KEY=set-this-only-in-server-environment

# ---------- Development auth bypass ----------
# When true, the app skips V2i ID login and signs in a local dev user.
# MUST be false in any production build.
VITE_DEV_AUTH_BYPASS=true
VITE_DEV_USER_EMAIL=dev@v2i.local

# ---------- AI Provider (chat brain) ----------
# Selected provider: "anthropic" | "openai" | "mock"
VITE_AI_PROVIDER=anthropic
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
VITE_ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional secondary provider (used if primary fails / for comparison tooling)
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o

# NOTE ON KEY EXPOSURE: calling a provider directly from the browser exposes the
# key to the client bundle. AIService is written to call a same-origin proxy path
# (/api/ai/complete) when VITE_AI_PROXY=true — see src/services/ai/README in code
# comments. For a quick local prototype you may set VITE_AI_PROXY=false to call the
# provider directly, but do NOT ship that to production.
VITE_AI_PROXY=false

# ---------- Speech-to-Text provider ----------
# "whisper" | "browser" | "mock"
VITE_STT_PROVIDER=whisper
VITE_WHISPER_API_KEY=
VITE_WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions

# ---------- Text-to-Speech provider ----------
# "elevenlabs" | "browser" | "mock"
VITE_TTS_PROVIDER=elevenlabs
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=
VITE_ELEVENLABS_API_URL=https://api.elevenlabs.io/v1

# ---------- Web research / search provider ----------
# "brave" | "serpapi" | "none"
VITE_SEARCH_PROVIDER=brave
VITE_SEARCH_API_KEY=
VITE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

# ---------- V2i Ecosystem integration endpoints ----------
# Leave blank until each service exposes a real API. Adapters detect blank config
# and report "not configured" rather than failing silently or faking success.
VITE_V2I_ID_ENDPOINT=
VITE_V2I_ID_CLIENT_ID=
VITE_V2I_VOICE_ENDPOINT=
VITE_V2I_VOICE_API_KEY=
VITE_BEGINNING_WRITE_ENDPOINT=
VITE_BEGINNING_WRITE_API_KEY=
VITE_YUNIVERSE_ENDPOINT=
VITE_YUNIVERSE_API_KEY=

# ---------- App ----------
VITE_APP_NAME=V2i Personal AI
VITE_DEFAULT_LANGUAGE=hinglish
